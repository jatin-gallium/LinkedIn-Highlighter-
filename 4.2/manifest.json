{
  "manifest_version": 3,
  "name": "LinkedIn Engagement Highlighter V4.2",
  "version": "4.2.2",
  "description": "LinkedIn engagement analyzer with strict parsing, suspect detection, safer automation defaults, SPA reliability fixes, and lightweight diagnostics. Fully client-side.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
